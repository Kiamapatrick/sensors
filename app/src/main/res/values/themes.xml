<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light). -->
    <style name="Base.Theme.SensorLab" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>

        <!-- Error -->
        <item name="colorError">@color/md_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/md_surface</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.SensorLab" parent="Base.Theme.SensorLab" />

    <!-- TextAppearance styles for consistent labeling -->
    <style name="TextAppearance.SensorLab.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/text_caption</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.SensorLab.Value" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.SensorLab.Value.Mono" parent="TextAppearance.SensorLab.Value">
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.SensorLab.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_heading</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SensorLab.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SensorLab.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chip styles -->
    <style name="SensorLabChipStatus">
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="android:paddingHorizontal">@dimen/chip_padding_horizontal</item>
        <item name="android:textAppearance">@style/TextAppearance.SensorLab.Label</item>
    </style>

    <!-- Card style -->
    <style name="Widget.SensorLab.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardUseCompatPadding">true</item>
    </style>
</resources>