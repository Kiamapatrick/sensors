<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:theme="?attr/actionBarTheme">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="@string/app_name"
            app:menu="@menu/menu_main"
            app:navigationIcon="@drawable/ic_menu_24" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/screen_margin"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin">

            <!-- Device Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/device_card"
                style="@style/Widget.SensorLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin_bottom"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/device_card_title"
                        style="@style/TextAppearance.SensorLab.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_info_title" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Manufacturer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <TextView
                            style="@style/TextAppearance.SensorLab.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_manufacturer" />

                        <TextView
                            android:id="@+id/tv_manufacturer"
                            style="@style/TextAppearance.SensorLab.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Google" />
                    </LinearLayout>

                    <!-- Model -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <TextView
                            style="@style/TextAppearance.SensorLab.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_model" />

                        <TextView
                            android:id="@+id/tv_model"
                            style="@style/TextAppearance.SensorLab.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Pixel 7" />
                    </LinearLayout>

                    <!-- Android Version + API Level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <TextView
                            style="@style/TextAppearance.SensorLab.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_android_version" />

                        <TextView
                            android:id="@+id/tv_android_version"
                            style="@style/TextAppearance.SensorLab.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Android 14 (API 34)" />
                    </LinearLayout>

                    <!-- Hardware -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <TextView
                            style="@style/TextAppearance.SensorLab.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_hardware" />

                        <TextView
                            android:id="@+id/tv_hardware"
                            style="@style/TextAppearance.SensorLab.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="qcom" />
                    </LinearLayout>

                    <!-- Environment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <TextView
                            style="@style/TextAppearance.SensorLab.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_environment" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_environment"
                                style="@style/SensorLabChipStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                tools:text="Physical device" />

                            <TextView
                                android:id="@+id/tv_total_sensors"
                                style="@style/TextAppearance.SensorLab.Display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:contentDescription="@string/total_sensors_label"
                                android:onClick="@{() -> view.onLongClick(view)}"
                                tools:text="12" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_emulator_caution"
                            style="@style/TextAppearance.SensorLab.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/env_emulator_caution"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search/Filter Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin_bottom"
                android:hint="@string/search_hint"
                app:boxStrokeColor="?attr/colorOutlineVariant"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Showing Count -->
            <TextView
                android:id="@+id/tv_showing_count"
                style="@style/TextAppearance.SensorLab.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="end"
                tools:text="Showing 12 of 12" />

            <!-- Inventory RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sensors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_sensor" />

            <!-- Empty State View (initially hidden) -->
            <LinearLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:src="@drawable/ic_sensor_off_24"
                    android:contentDescription="@string/no_sensors_title"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    style="@style/TextAppearance.SensorLab.Heading"
                    android:text="@string/no_sensors_title"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    style="@style/TextAppearance.SensorLab.Label"
                    android:text="@string/no_sensors_explanation"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_empty_total"
                    style="@style/TextAppearance.SensorLab.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    tools:text="Total sensors: 0" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>