<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SensorLab.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_margin_bottom"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <!-- Left accent strip (status indicator) -->
        <View
            android:id="@+id/accent_strip"
            android:layout_width="@dimen/accent_strip_width"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@color/status_available" />

        <!-- Sensor info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:minHeight="@dimen/touch_target_min">

            <!-- Sensor Name (up to 3 lines, ellipsize at end) -->
            <TextView
                android:id="@+id/tv_sensor_name"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Accelerometer Sensor with a Very Long Name That Should Wrap Properly Across Multiple Lines Without Clipping" />

            <!-- Type + Vendor row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_sensor_type"
                    style="@style/TextAppearance.SensorLab.Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Accelerometer (type 1)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_wakeup"
                    style="@style/SensorLabChipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone"
                    tools:text="Wake-up"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Vendor -->
            <TextView
                android:id="@+id/tv_sensor_vendor"
                style="@style/TextAppearance.SensorLab.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Vendor: Google Inc." />
        </LinearLayout>

        <!-- Chevron indicator -->
        <ImageView
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_md"
            android:contentDescription="@string/cd_sensor_row"
            android:src="@drawable/ic_chevron_right_24"
            android:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>